#include <stdio.h>
int es_primo(int numero);


int main(){
	int numero, verificar;
	
	printf("Ingrese un numero: ");
	scanf("%d", &numero);
	
	verificar = es_primo(numero);
	printf("\n # %d", verificar);
	
	return 0;
}
int es_primo(int numero){
	int divisores, i;
	divisores = 0;
	
	for(i=1; i <= numero; i++){
		if(numero % i == 0){
			divisores = divisores + 1;
		}
	}
	
	if(divisores <= 2){
		return 1;
	}
	else{
		return 0;
	}
}

