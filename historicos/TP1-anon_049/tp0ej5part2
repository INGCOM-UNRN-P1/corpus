#include <stdio.h>
int divide_lento(int dividendo, int divisor);
int resto_lento(int dividendo, int divisor);

 
int main(){
	int numero1, numero2, division, resto;
	
	do{
		printf("\nIngrese un numero # ");
		scanf("%d", &numero1);
		printf("\nIngrese otro numero para dividir el primero # ");
		scanf("%d", &numero2); 
	}while(numero2 > 0 && numero1 < numero2);
	
	division = divide_lento(numero1, numero2);
	printf("\nEl resultado de la division %d / %d es: %d ", numero1, numero2, division);
	resto = resto_lento(numero1, numero2);
	printf("\nEl resto de la division es: %d", resto);
	
	return 0;
}
int divide_lento(int dividiendo, int divisor){
	int resultado;
	resultado = 0;
	while(dividiendo >= divisor){
		dividiendo = dividiendo - divisor;
		resultado = resultado +1;
	}
	return resultado;
	
}
int resto_lento(int dividiendo, int divisor){
	int resto;
	resto = 0;
	
	while(dividiendo >= divisor){
		dividiendo = dividiendo - divisor;
	}
	resto = dividiendo;
	return resto;
}