#include <stdio.h>
#include <string.h>

#define MAX_CADENA 60
#define MAX_LINEAS 5
#define MAX_CAR 10
#define SIN_ESPACIO -1
#define CADENA_VACIA -1

int largo_cadena(char *cadena, int capacidad_cadena);
int token_matriz(char cadena[MAX_CADENA], int largo_tot,char matriz[MAX_LINEAS][MAX_CAR]);

int main(int argc, char *argv[])
{
    int lineas = MAX_LINEAS;
	char cadena[MAX_CADENA]= "\0";
    char matriz[MAX_LINEAS][MAX_CAR];
    int i,j, largo, largo_tot, resultado;
	
    printf("\n Ingresar las palabras que conforman la cadena a dividir separadas por enter\n\n");
	printf("\n Cantidad maxima de lineas: %d\n", MAX_LINEAS);
	printf(" Cantidad maxima de caracteres: %d\n", MAX_CAR);
	
	printf(" Ingresar %d lineas\n\n",lineas);
    for(;lineas>0;lineas--)
    {
        largo = strlen(cadena);
        printf(" %d caracteres, linea %d: \n", largo, lineas); 
        fgets(cadena+largo, MAX_CADENA+largo, stdin);
		
		if((largo > MAX_CADENA))
		{
			break;
		}
    }
	   
	largo_tot = largo_cadena(cadena, MAX_CADENA);
	printf("\n El string cargado es\n<%s>\n\n",cadena);

	memset(matriz,0,MAX_LINEAS*MAX_CAR);
	
	resultado = token_matriz(cadena, largo_tot, matriz);
    
    return 0;
} 

int largo_cadena(char *cadena, int capacidad_cadena)
{
    int i = 0;
    int largo = 0; 
    
    while(i < capacidad_cadena)
    {
        if(cadena[i] == '\0')
        {
            return i;
        }
        else
        {
            largo = largo+1;
        }
        i++;
    }    
    if (largo > 0)
    {
        return largo;
    }
    else
    {
        return CADENA_VACIA;
    }
}

int token_matriz(char cadena[MAX_CADENA], int largo_tot,char matriz[MAX_LINEAS][MAX_CAR])
{
	int i,j;
	int cant_lineas = 0;
	int caracteres = 0;
	
	printf(" Largo cadena: %d",largo_tot);    
	
    for(int i=0; i<largo_tot; i++)
    {
        if(cadena[i] == '\n' )
        {
            cant_lineas++;    
        }
    }
	printf("\n Cantidad de lineas: %d \n", cant_lineas);
	
	printf("\n La matriz resultante es:  ");

    if((cant_lineas <= MAX_LINEAS)&&(largo_tot > 0))
    {
		for(i=0; i<largo_tot; i++)
        { 
		                                                      
			caracteres = 0;
			printf("\n >: ");
			
			for(j=i; j< i+MAX_CAR; j++)
			{
				if(cadena[j]!='\n')
				{
					caracteres++;                                       
					matriz[i][j]= cadena[j];                               
					putc(matriz[i][j],stdout);             
				}
				else
				{
					if(caracteres<MAX_CAR)
					{
						matriz[i][j]= '\0';
						i+= caracteres;
						break;
					}
					else
					{
						printf("Error. Se supero la cantidad maxima de caracteres por fila");
						break;
					}
				}
			}			                                               
        }
		putc('\n',stdout);
	}
	else
    {
        if(cant_lineas > MAX_LINEAS)
        {
            printf(" La cadena tiene: %d lineas.supera la cantidad maxima permitida: %d.\n", cant_lineas, MAX_LINEAS);
            return SIN_ESPACIO;
        } 
        else
        {
            printf(" Cadena vacia.\n");
            return CADENA_VACIA;
        } 
    }
        
	return 0;	
}

